# BitePrint Coach — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Required — Google AI Studio API key for Gemini Vision
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required — Spline scene URL (from your Spline.design project export)
NEXT_PUBLIC_SPLINE_URL=https://prod.spline.design/your-scene-id/scene.splinecode
